# Copia este archivo como `.env.local` y ajusta los valores.
# Las variables VITE_* quedan visibles en el navegador: nunca guardes claves ni contraseñas aquí.

# "demo": usa datos simulados (no necesita backend). Es el valor por defecto si no defines nada.
# "api":  usa la API real del backend.
VITE_API_MODE=demo

# Ruta base de la API. En desarrollo conviene dejar la ruta relativa: Vite reenvía /api al backend
# (ver VITE_API_PROXY_TARGET) y se evitan problemas de CORS.
VITE_API_BASE_URL=/api/asistencia

# Dirección del backend a la que Vite reenvía las peticiones /api (solo en `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:8000

# Código del dispositivo "web" registrado en el catálogo del backend. Es obligatorio en modo api
# para poder marcar (el backend aún no define el valor; ver docs/CONTRATOS_PENDIENTES.md).
VITE_CODIGO_DISPOSITIVO_WEB=

# Ruta (relativa a VITE_API_BASE_URL) que devuelve el listado de trabajadores para el filtro de RR. HH.
# Déjala vacía mientras el backend no la publique.
VITE_API_RUTA_TRABAJADORES=

# SOLO PARA PRUEBAS LOCALES en modo api, mientras no exista autenticación: identifican a quien usa la pantalla.
VITE_PRUEBA_TRABAJADOR_ID=
VITE_PRUEBA_EMPRESA_ID=
VITE_PRUEBA_TRABAJADOR_NOMBRE=
VITE_PRUEBA_ES_RRHH=false
